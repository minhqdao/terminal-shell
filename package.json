{
  "name": "terminal-shell",
  "version": "0.1.0",
  "description": "Dependency-free web terminal for retro-computing WASM games: append-only output, single-line input, bottom-pinned scrolling, and a SharedArrayBuffer runner protocol between page, worker, and Emscripten module.",
  "type": "module",
  "sideEffects": [
    "./src/runner-worker.js"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/minhqdao/terminal-shell.git"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "files": [
    "src",
    "demo",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": "./src/index.js",
    "./protocol": "./src/runner-protocol.js",
    "./runner-worker": "./src/runner-worker.js",
    "./emscripten-runner": "./src/emscripten-runner.js",
    "./terminal-input": "./src/terminal-input.js",
    "./terminal-keyboard": "./src/terminal-keyboard.js",
    "./terminal-log": "./src/terminal-log.js",
    "./terminal-output": "./src/terminal-output.js",
    "./terminal-render": "./src/terminal-render.js",
    "./terminal-scroll": "./src/terminal-scroll.js",
    "./terminal-selection": "./src/terminal-selection.js",
    "./terminal-shell": "./src/terminal-shell.js",
    "./terminal-text": "./src/terminal-text.js"
  },
  "scripts": {
    "dev": "npx -y serve . -l 3000",
    "test": "node --test",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "all": "npm run format:check && npm run lint && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "jsdom": "^30.1.0",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2"
  }
}
